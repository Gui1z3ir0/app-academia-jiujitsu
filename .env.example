# 1. Backend Supabase (PostgreSQL + Auth + RLS + Realtime)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publica_anon_do_supabase

# 2. App Mobile Principal (Expo / React Native + Supabase + Expo Notifications)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publica_anon_do_supabase
EXPO_PUBLIC_PAYMENT_WEBHOOK_URL=https://seu-projeto.supabase.co/functions/v1/payment-webhook

# 3. Gateway de Pagamento na Edge Function (CONTA DO DONO DA ACADEMIA — Asaas recomendado p/ recorrência)
VITE_PAYMENT_GATEWAY_PROVIDER=asaas
VITE_PAYMENT_WEBHOOK_URL=https://seu-projeto.supabase.co/functions/v1/payment-webhook
ASAAS_API_KEY=chave_api_asaas_da_conta_do_dono_da_academia
ASAAS_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=token_opcional_se_usar_mercadopago
WEBHOOK_SECRET=segredo_para_validar_webhook_do_asaas
